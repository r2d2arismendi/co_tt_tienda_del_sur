{
  "contractName": "ventas",
  "delimiter": ",", 
  "fields": [
    {
      "name": "Fecha de factura",
      "type": "date",
      "format": "YYYYMMDD",
      "required": true
    },
    {
      "name": "Codigo del distribuidor",
      "type": "string",
      "regex": "^[A-Z0-9]+$",
      "required": true
    },
    {
      "name": "Tipo de factura",
      "type": "integer",
      "min": 1,
      "max": 10,
      "required": true
    }
  ]
}