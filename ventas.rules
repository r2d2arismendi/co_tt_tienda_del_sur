{
  "contractName": "ventas",
  "delimiter": ",", 
  "fields": [
    {
      "name": "Fecha de factura",
      "type": "date",
      "format": "YYYYMMDD",
      "required": true
    },
    {
      "name": "Codigo del distribuidor",
      "type": "string",
      "regex": "^[A-Z0-9]+$",
      "required": true
    },
    {
      "name": "Tipo de factura",
      "type": "integer",
      "min": 1,
      "max": 10,
      "required": true
    },
    {
      "name": "Numero de factura",
      "type": "string",
      "regex": "^[A-Z0-9]+$",
      "required": false
    },
    {
      "name": "Codigo de cliente (PDV)",
      "type": "integer",
      "min": 1,
      "max": 10000000000,
      "required": false
    },
    {
      "name": "Nombre de cliente",
      "type": "string",
      "regex": "^[A-Z\\s]+$",
      "required": false
    },
    {
      "name": "Codigo del SKU SAP",
      "type": "integer",
      "required": false
    },
    {
      "name": "Codigo del vendedor",
      "type": "string",
      "regex": "^[A-Z0-9]+$",
      "required": true
    },
    {
      "name": "Nombre de vendedor",
      "type": "string",
      "regex": "^[A-Z\\s]+$",
      "required": false
    },
    {
      "name": "Cantidad",
      "type": "integer",
      "required": true
    },
    {
      "name": "Unidad de medida",
      "type": "string",
      "allowedValues": ["TON", "KG", "EACH","UNIT"],
      "required": true
    },
    {
      "name": "Valor de venta sin IVA - IGV",
      "type": "decimal",
      "decimalPlaces": 2,
      "min": 0,
      "max": 1000000,
      "required": true
    }
  ]
}
